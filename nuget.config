<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep the engine's managed build hermetic. Without this, NuGet walks up to
  %APPDATA%\NuGet\NuGet.Config and inherits whatever sources that machine has
  configured; a dead local feed there fails the restore with NU1301 as soon as
  anything forces a real (non-cached) restore. Dorifto's own nuget.config
  clears sources for the same reason.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
